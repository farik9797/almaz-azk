# Статический сайт ТОО «АЗК Алмаз». Hoster.KZ, Plesk: nginx спереди, Apache сзади.
# Проверено на живом сервере: ErrorDocument и сроки кэша применяются,
# а заголовки <IfModule mod_headers.c> в ответе НЕ появляются — модуль, похоже,
# не подключён. Если они нужны, их придётся добавить в Plesk → Apache & nginx
# Settings → Additional nginx directives.

# --- Редиректы ---------------------------------------------------------------
# Проверено на живом сервере 15.10.2026:
#   http → https делает сам Plesk (после выпуска Let's Encrypt) — дублировать не надо;
#   www → без www Plesk НЕ делает: без правила ниже https://www.azkalmaz.kz/
#   отдаёт 200 и сайт доступен на двух хостах сразу. Правило нужно.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# --- Своя страница 404 ------------------------------------------------------
ErrorDocument 404 /404.html

# --- Сжатие -----------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Кэш --------------------------------------------------------------------
# Картинки и шрифты меняются редко. HTML и словари переводов — наоборот,
# поэтому им короткий срок: правки клиента должны доезжать быстро.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType text/html                 "access plus 10 minutes"
  ExpiresByType application/xml           "access plus 1 day"
</IfModule>

# --- Базовая безопасность ---------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes

# Служебные файлы проекта не должны быть доступны снаружи
<FilesMatch "^(PROGRESS\.md|password\.md|.*\.docx|.*\.csv)$">
  Require all denied
</FilesMatch>
